<Window x:Class="PixelSnapper.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="픽셀 스냅퍼" Width="1180" Height="860" MinWidth="940" MinHeight="760" WindowStartupLocation="CenterScreen" Icon="Assets/PixelSnapper.ico" Style="{StaticResource {x:Type Window}}"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" Closing="Window_Closing">
  <Grid Margin="26,22,26,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Background="#5CE1CE" Width="45" Height="45" CornerRadius="10" Margin="0,0,14,0"><TextBlock Text="▦" FontSize="33" Foreground="#102D32" HorizontalAlignment="Center" Margin="0,-4,0,0"/></Border>
        <StackPanel><TextBlock Text="픽셀 스냅퍼" FontSize="25" FontWeight="Bold"/><TextBlock Text="이미지를 정돈된 픽셀 아트로" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="VersionLabel" Foreground="{StaticResource Muted}" Margin="0,0,12,0"/><CheckBox x:Name="AutoUpdateCheck" Content="시작 시 업데이트 확인" Foreground="#EAF0F8" VerticalAlignment="Center" Margin="0,0,12,0" Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed"/><Button x:Name="UpdateButton" Content="업데이트 확인" Click="Update_Click" Padding="14,8" Margin="0,0,8,0"/><Button Content="사용 안내" Click="Help_Click" Padding="14,8"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="#2B3A50" BorderThickness="1" Background="#192333" CornerRadius="12" Padding="16">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,14"><TextBlock Text="이미지 목록" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="CountLabel" Text="0개" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel>
          <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,12"><Button x:Name="AddButton" Content="＋ 파일 추가" Click="AddFiles_Click" Margin="0,0,7,0" Padding="4,10"/><Button x:Name="FolderButton" Content="폴더 추가" Click="AddFolder_Click" Padding="4,10" ToolTip="선택한 폴더 바로 안의 PNG·JPG 이미지를 추가합니다."/></UniformGrid>
          <Grid Grid.Row="2">
            <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" Foreground="#EAF0F8" SelectionChanged="FileList_SelectionChanged" PreviewKeyDown="FileList_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Background" Value="#202D41"/><Setter Property="Foreground" Value="#EAF0F8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#5CE1CE"/><Setter TargetName="ItemBorder" Property="Background" Value="#253C4C"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#304159"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate><StackPanel ToolTip="{Binding InputPath}"><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" Margin="0,6,0,0" FontSize="12"/><TextBlock Text="{Binding Details}" TextTrimming="CharacterEllipsis" Foreground="#E7B978" FontSize="11" Margin="0,3,0,0" ToolTip="{Binding Details}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" IsHitTestVisible="False" Margin="10"><TextBlock Text="＋" FontSize="38" Foreground="#5CE1CE" HorizontalAlignment="Center"/><TextBlock Text="이미지를 여기에&#10;끌어놓으세요" TextAlignment="Center" FontSize="16" LineHeight="25" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock Text="PNG · JPG · JPEG" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/></StackPanel>
          </Grid>
          <UniformGrid Grid.Row="3" Columns="2" Margin="0,12,0,0"><Button x:Name="RemoveButton" Content="선택 제외" Click="Remove_Click" ToolTip="선택한 이미지를 목록에서 제외합니다. 단축키: Delete (원본 파일은 유지됩니다.)" Padding="5,8" Margin="0,0,7,0" IsEnabled="False"/><Button x:Name="ClearButton" Content="목록 비우기" Click="Clear_Click" Padding="5,8" IsEnabled="False"/></UniformGrid>
        </Grid>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12"><TextBlock Text="미리보기" FontWeight="SemiBold" FontSize="15"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="확대" Foreground="{StaticResource Muted}" Margin="0,0,9,0"/><ComboBox x:Name="ZoomBox" Width="112" SelectedIndex="0" SelectionChanged="Zoom_Changed"><ComboBoxItem Content="화면에 맞춤"/><ComboBoxItem Content="100%"/><ComboBoxItem Content="200%"/><ComboBoxItem Content="400%"/><ComboBoxItem Content="800%"/></ComboBox></StackPanel></DockPanel>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border BorderBrush="#2B3A50" BorderThickness="1" CornerRadius="10" Background="#192333" ClipToBounds="True">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Margin="14,12"><TextBlock Text="원본" FontWeight="SemiBold"/><TextBlock x:Name="BeforeSize" Foreground="{StaticResource Muted}" FontSize="11" Margin="10,0,0,0"/></StackPanel>
              <Grid Grid.Row="1" Background="{StaticResource Checker}"><ScrollViewer x:Name="BeforeScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="Preview_SizeChanged" Padding="12"><Viewbox x:Name="BeforeBox" Stretch="Uniform"><Image x:Name="BeforeImage" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Viewbox></ScrollViewer><TextBlock x:Name="BeforeHint" Text="이미지를 선택해 주세요" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" IsHitTestVisible="False"/></Grid>
            </Grid>
          </Border>
          <Border Grid.Column="2" BorderBrush="#34535C" BorderThickness="1" CornerRadius="10" Background="#192333" ClipToBounds="True">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Margin="14,12"><TextBlock Text="변환 미리보기" Foreground="#5CE1CE" FontWeight="SemiBold"/><TextBlock x:Name="AfterSize" Foreground="{StaticResource Muted}" FontSize="11" Margin="10,0,0,0"/></StackPanel>
              <Grid Grid.Row="1" Background="{StaticResource Checker}"><ScrollViewer x:Name="AfterScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="Preview_SizeChanged" Padding="12"><Viewbox x:Name="AfterBox" Stretch="Uniform"><Image x:Name="AfterImage" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Viewbox></ScrollViewer><TextBlock x:Name="AfterHint" TextWrapping="Wrap" TextAlignment="Center" Margin="18" Text="이미지를 추가하면 자동으로 미리 봅니다" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" IsHitTestVisible="False"/></Grid>
            </Grid>
          </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="PreviewNote" Text="미리보기는 자동 갱신됩니다. 파일을 저장하려면 변환 시작을 누르세요." Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/><Button x:Name="OpenResultButton" Content="저장한 파일 열기 ↗" ToolTip="변환 시작으로 마지막에 저장한 결과 파일을 엽니다. 현재 미리보기와 다를 수 있습니다." Padding="12,7" HorizontalAlignment="Right" Click="OpenResult_Click" IsEnabled="False"/></DockPanel>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#192333" BorderBrush="#2B3A50" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,18,0,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="CustomOutputSizeCheck" Content="출력 크기 지정" Foreground="#EAF0F8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,22,0" Checked="OutputSizeMode_Changed" Unchecked="OutputSizeMode_Changed"/>
            <TextBlock Text="가로" Margin="0,0,8,0"/>
            <TextBox x:Name="OutputWidthBox" Width="82" MaxLength="5" IsEnabled="False" TextChanged="OutputWidth_Changed" AutomationProperties.Name="출력 가로 픽셀" ToolTip="결과 PNG의 가로 픽셀 수입니다. 1~8192 사이의 정수를 입력하세요."/>
            <TextBlock Text="px" Foreground="{StaticResource Muted}" Margin="6,0,12,0"/>
            <ToggleButton x:Name="AspectRatioToggle" Width="36" Height="34" IsChecked="True" IsEnabled="False" Checked="AspectRatio_Changed" Unchecked="AspectRatio_Changed" AutomationProperties.Name="원본 비율 유지" ToolTip="원본 비율 유지 · 끄면 가로와 세로를 각각 지정합니다." Margin="0,0,12,0" Cursor="Hand">
              <ToggleButton.Style>
                <Style TargetType="ToggleButton">
                  <Setter Property="Foreground" Value="#9BAAC0"/>
                  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ChainBorder" CornerRadius="6" Background="#111824" BorderBrush="#3B4C65" BorderThickness="1">
                      <Grid Width="24" Height="24">
                        <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M10,13 A5,5 0 0 0 17.54,13.54 L20.54,10.54 A5,5 0 0 0 13.47,3.47 L11.75,5.18 M14,11 A5,5 0 0 0 6.46,10.46 L3.46,13.46 A5,5 0 0 0 10.53,20.53 L12.24,18.82"/>
                        <Path x:Name="UnlinkedMark" Stroke="#9BAAC0" StrokeThickness="2" Data="M4,4 L20,20"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#5CE1CE"/><Setter TargetName="ChainBorder" Property="BorderBrush" Value="#5CE1CE"/><Setter TargetName="UnlinkedMark" Property="Visibility" Value="Collapsed"/></Trigger>
                      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ChainBorder" Property="Opacity" Value="0.4"/></Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChainBorder" Property="BorderThickness" Value="2"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate></Setter.Value></Setter>
                </Style>
              </ToggleButton.Style>
            </ToggleButton>
            <TextBlock Text="세로" Margin="0,0,8,0"/>
            <TextBox x:Name="OutputHeightBox" Width="82" MaxLength="5" IsEnabled="False" TextChanged="OutputHeight_Changed" AutomationProperties.Name="출력 세로 픽셀" ToolTip="결과 PNG의 세로 픽셀 수입니다. 1~8192 사이의 정수를 입력하세요."/>
            <TextBlock Text="px" Foreground="{StaticResource Muted}" Margin="6,0,16,0"/>
            <TextBlock x:Name="AspectRatioState" Text="원본 비율 유지" Foreground="#5CE1CE" FontSize="12"/>
          </StackPanel>
          <TextBlock x:Name="OutputSizeHint" Text="지정하지 않으면 격자 변환 결과 크기로 저장합니다." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Height="1" Background="#2B3A50" Margin="0,13,0,13"/>
        <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,18,0">
          <StackPanel Orientation="Horizontal"><TextBlock Text="색상 수" FontWeight="SemiBold" Width="68"/><TextBox x:Name="ColorsBox" Width="70" Text="16" TextChanged="PreviewOption_Changed" ToolTip="팔레트에 사용할 최대 색상 수입니다. 1~256 사이의 정수를 입력하세요."/><TextBlock Text="1–256" Foreground="{StaticResource Muted}" FontSize="11" Margin="9,0,0,0"/></StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
            <TextBlock Text="세밀도" FontWeight="SemiBold" Width="68"/>
            <RadioButton x:Name="AutoPixelSizeRadio" Content="자동" GroupName="PixelSizeMode" IsChecked="True" Checked="PixelSizeMode_Changed" Margin="0,0,12,0"/>
            <RadioButton x:Name="ManualPixelSizeRadio" Content="직접 지정" GroupName="PixelSizeMode" Checked="PixelSizeMode_Changed" Margin="0,0,8,0"/>
            <TextBox x:Name="PixelSizeBox" Width="64" Text="8" TextChanged="PreviewOption_Changed" IsEnabled="False" ToolTip="작은 숫자일수록 더 세밀해지고, 큰 숫자일수록 굵고 단순하게 표현됩니다. 1 이상, 이미지의 짧은 변 길이의 절반 이하로 입력하세요. 소수도 사용할 수 있습니다."/>
            <TextBlock Text="px" Foreground="{StaticResource Muted}" FontSize="11" Margin="6,0,0,0"/>
          </StackPanel>
          <TextBlock Text="작은 숫자일수록 더 세밀해집니다. 큰 숫자는 더 굵게 표현됩니다." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Column="1" Background="#2B3A50"/>
        <StackPanel Grid.Column="2" Margin="20,0,0,0"><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="저장 위치" FontWeight="SemiBold" Margin="0,0,20,0"/><RadioButton x:Name="AlongsideRadio" Content="원본 이미지 옆" GroupName="Destination" IsChecked="True" Checked="Destination_Changed"/><RadioButton x:Name="CustomRadio" Content="폴더 지정" GroupName="Destination" Checked="Destination_Changed"/></StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OutputBox" IsReadOnly="True" Text="" ToolTip="결과를 저장할 폴더"/><Button x:Name="BrowseOutputButton" Grid.Column="1" Content="찾아보기" Click="BrowseOutput_Click" Margin="8,0,0,0" Padding="14,7"/></Grid>
          <TextBlock Text="원본은 보존하고, 결과는 파일명_snapped.png로 저장합니다. 같은 이름이 있으면 번호를 붙입니다." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        </Grid>
      </Grid>
    </Border>
    <Grid Grid.Row="3" Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,24,0"><TextBlock x:Name="StatusLabel" Text="이미지를 추가하면 시작할 수 있습니다." TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="Progress" Height="5" Margin="0,10,0,0" Background="#283548" Foreground="#5CE1CE" BorderThickness="0" Maximum="1" Value="0"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="OpenFolderButton" Content="저장 폴더 열기" Click="OpenFolder_Click" IsEnabled="False" Margin="0,0,10,0"/><Button x:Name="CancelButton" Content="중지" Click="Cancel_Click" Visibility="Collapsed" Margin="0,0,10,0"/><Button x:Name="ConvertButton" Content="변환 시작" Click="Convert_Click" Background="#5CE1CE" Foreground="#102D32" BorderBrush="#5CE1CE" FontWeight="Bold" FontSize="15" MinWidth="145" Padding="22,13" IsEnabled="False"/></StackPanel>
    </Grid>
  </Grid>
</Window>
